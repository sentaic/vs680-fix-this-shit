					reg = <0x43>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-parent = <0x37>;
					interrupts = <0x16 0x08>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					#address-cells = <0x00>;
					phandle = <0x1d>;
				};

				gpio@44 {
		status = "disabled";
					compatible = "fcs,fxl6408";
					reg = <0x44>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-parent = <0x37>;
					interrupts = <0x16 0x08>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					#address-cells = <0x00>;
					phandle = <0x7d>;

					wifi_enable {
						gpio-hog;
						gpios = <0x06 0x00>;
						output-high;
					};
				};
			};

			uart@d000 {
				compatible = "snps,dw-apb-uart";
				reg = <0xd000 0x100>;
				interrupts = <0x08>;
				clocks = <0x12>;
				reg-shift = <0x02>;
				status = "okay";
				phandle = <0x7e>;
			};

			uart@e000 {
				compatible = "snps,dw-apb-uart";
				reg = <0xe000 0x100>;
				interrupts = <0x09>;
				clocks = <0x12>;
				reg-shift = <0x02>;
				status = "disabled";
				phandle = <0x7f>;
			};
		};

		pinctrl@f7fe2c10 {
			compatible = "syna,dolphin-system-pinctrl";
			reg = <0xf7fe2c10 0x0c 0xf7fe2c1c 0x5c>;
			phandle = <0x80>;

			i2c2-pmux {
				groups = "SM_URT1_TXD\0SM_URT1_RXD";
				function = "tw2b";
				drive-strength = <0x07>;
				phandle = <0x35>;
			};

			i2c3-pmux {
				groups = "SM_TW3_SCL\0SM_TW3_SDA";
				function = "tw3";
				drive-strength = <0x07>;
				phandle = <0x36>;
			};

			uart2-pmux {
				groups = "SM_SPI2_SS2n\0SM_SPI2_SS3n";
				function = "uart2";
				drive-strength = <0x03>;
				phandle = <0x2a>;
			};

			spi2-pmux {
				groups = "SM_SPI2_SDO\0SM_SPI2_SDI\0SM_SPI2_SCLK\0SM_SPI2_SS0n\0SM_SPI2_SS1n";
				function = "spi2";
				drive-strength = <0x07>;
				phandle = <0x34>;
			};

			hrx5v-pmux {
				groups = "SM_HDMIRX_PWR5V";
				function = "gpio";
				drive-strength = <0x07>;
				phandle = <0x1c>;
			};
		};

		isp@f9100000 {
			status = "disabled";
			compatible = "syna,dolphin-isp";
			reg = <0xf9100000 0x100000>;
			clocks = <0x0b 0x2a 0x0b 0x19 0x0b 0x18 0x0b 0x1a 0x0b 0x1b 0x0b 0x1c 0x0b 0x1d>;
			clock-names = "txescclk\0ispclk\0isssysclk\0ispbeclk\0ispdscclk\0ispcsi0clk\0ispcsi1clk";
			resets = <0x20 0x688 0x08 0x01 0x00>;
			reset-names = "isprst";
			interrupts = <0x00 0x70 0x04 0x00 0x74 0x04>;
			interrupt-names = "isp_core\0isp_tsb_dhub";
			enable-gpios = <0x37 0x0f 0x00>;
			i2c-bus = <0x38>;
			dev-addr = <0x70>;
			phandle = <0x81>;
		};

		cec@f7fe1000 {
			compatible = "syna,berlin-cec";
			interrupt-parent = <0x33>;
			interrupts = <0x10>;
			reg = <0xf7fe1000 0x1000>;
			status = "disabled";
			phandle = <0x82>;
		};

		vpp {
			status = "disabled";
			compatible = "syna,vpp-drv";
			clocks = <0x0e 0x00 0x0f 0x00>;
			clock-names = "avio_vclk0\0avio_dpiclk";
			phandle = <0x83>;
		};

		fb {
			compatible = "marvell,berlin-fb";
			frame-size-ndx = <0x01>;
			status = "disabled";
			phandle = <0x84>;
		};
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon root=/dev/mmcblk0p16 rootfstype=ext4 rootwait ro net.ifnames=0";
		stdout-path = "serial0:115200n8";
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x4a00000 0x00 0x71a00000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		ramoops@f901c000 {
			compatible = "ramoops";
			reg = <0x00 0xf901c000 0x00 0x4000>;
			record-size = <0x4000>;
		};
	};

	ion {
		status = "disabled";
		compatible = "syna,ion-berlin-heaps";
		pool-num = <0x02>;
		reg-names = "Secure\0NonSecure-NC";
		reg = <0x00 0x76e00000 0x00 0x9200000 0x00 0x76400000 0x00 0xa00000>;
		attributes-num-per-pool = <0x02>;
		pool-attributes = <0x05 0xf3d 0x05 0xf3a>;
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		vmmc_sdhci1 {
			compatible = "regulator-fixed";
			regulator-min-microvolt = <0x325aa0>;
			regulator-max-microvolt = <0x325aa0>;
			regulator-name = "vmmc_sdio";
			enable-active-high;
			gpio = <0x37 0x10 0x00>;
			phandle = <0x22>;
		};

		usb0_vbus {
			compatible = "regulator-fixed";
			regulator-name = "usb0_vbus";
			regulator-min-microvolt = <0x4c4b40>;
			regulator-max-microvolt = <0x4c4b40>;
			regulator-always-on;
			phandle = <0x26>;
		};

		xhci0_vbus {
			compatible = "regulator-fixed";
			regulator-name = "xhci0_vbus";
			regulator-min-microvolt = <0x4c4b40>;
			regulator-max-microvolt = <0x4c4b40>;
			gpio = <0x37 0x11 0x00>;
			enable-active-high;
			phandle = <0x28>;
		};
	};

	dummy_label {
		dummy1 = <0x06>;
		dummy2 = <0x39>;
	};

	bt_reg_on {
		status = "disabled";
		compatible = "syna,rfkill";
		phandle = <0x85>;
	};

	bluesleep {
		status = "disabled";
		compatible = "syna,bluesleep";
		bt-dev-wake-gpio = <0x10 0x02 0x01>;
		phandle = <0x86>;
	};

	panel0-backlight {
		compatible = "pwm-backlight";
		pinctrl-0 = <0x3a>;
		pinctrl-names = "pwm1";
		pwms = <0x3b 0x01 0xf4240 0x00>;
		brightness-levels = <0x00 0x04 0x08 0x10 0x20 0x40 0x80 0xff>;
		default-brightness-level = <0x06>;
		status = "disabled";
	};
};

/ { wdt_reset_mask: syscon@f7fe203c { compatible = "syscon"; reg = <0 0xf7fe203c 0 4>; }; };
&{/soc/apb@f7fc0000/watchdog@5000} { compatible = "syna,dolphin-wdt", "snps,dw-wdt"; syna,reset-mask = <&wdt_reset_mask 0 0x24>; };

/ { firmware { optee { compatible = "linaro,optee-tz"; method = "smc"; }; }; };
&{/soc/npu@f7bc0000} { status = "okay"; };
&{/ion} { compatible = "syna,berlin-heaps"; status = "okay"; };
