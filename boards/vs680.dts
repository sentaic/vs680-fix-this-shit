// SPDX-License-Identifier: GPL-2.0-only
/dts-v1/;

/ {
	compatible = "syna,dolphin";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "VS680 development board";

	aliases {
		serial0 = "/soc/apb@f7fc0000/uart@d000";
		serial1 = "/soc/apb@f7fc0000/uart@e000";
		serial2 = "/soc/apb@f7e80000/uart@1000";
		serial3 = "/soc/apb@f7e80000/uart@1400";
		i2c0 = "/soc/apb@f7e80000/i2c@1800";
		i2c1 = "/soc/apb@f7e80000/i2c@2000";
		i2c2 = "/soc/apb@f7fc0000/i2c@b000";
		i2c3 = "/soc/apb@f7fc0000/i2c@c000";
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a73";
			device_type = "cpu";
			reg = <0x00>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			cpu-idle-states = <0x03>;
			operating-points-v2 = <0x04>;
			clocks = <0x05 0x00>;
			cpu0-supply = <0x06>;
			phandle = <0x07>;
		};

		cpu@1 {
			compatible = "arm,cortex-a73";
			device_type = "cpu";
			reg = <0x01>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			cpu-idle-states = <0x03>;
			operating-points-v2 = <0x04>;
			clocks = <0x05 0x00>;
			phandle = <0x08>;
		};

		cpu@2 {
			compatible = "arm,cortex-a73";
			device_type = "cpu";
			reg = <0x02>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			cpu-idle-states = <0x03>;
			operating-points-v2 = <0x04>;
			clocks = <0x05 0x00>;
			phandle = <0x09>;
		};

		cpu@3 {
			compatible = "arm,cortex-a73";
			device_type = "cpu";
			reg = <0x03>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			cpu-idle-states = <0x03>;
			operating-points-v2 = <0x04>;
			clocks = <0x05 0x00>;
			phandle = <0x0a>;
		};

		l2-cache0 {
			compatible = "cache";
			phandle = <0x02>;
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x4b>;
				exit-latency-us = <0x9b>;
				min-residency-us = <0xc350>;
				phandle = <0x03>;
			};
		};

		opp_table0 {
			compatible = "operating-points-v2";
			opp-shared;
			phandle = <0x04>;

			opp@800000000 {
				opp-hz = <0x00 0x2faf0800>;
				opp-microvolt = <0xc96a8 0xc96a8 0xe1d48>;
				clock-latency-ns = <0xc042c0>;
			};

			opp@1400000000 {
				opp-hz = <0x00 0x53724e00>;
				opp-microvolt = <0xc96a8 0xc96a8 0xe1d48>;
				clock-latency-ns = <0xc042c0>;
			};

			opp@1800000000 {
				opp-hz = <0x00 0x6b49d200>;
				opp-microvolt = <0xc96a8 0xc96a8 0xe1d48>;
				clock-latency-ns = <0xc042c0>;
				opp-suspend;
			};

			opp@2100000000 {
				opp-hz = <0x00 0x7d2b7500>;
				opp-microvolt = <0xe1d48 0xe1d48 0xe1d48>;
				clock-latency-ns = <0xc042c0>;
			};
		};
	};

	osc {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x17d7840>;
		phandle = <0x12>;
	};

	pmu {
		compatible = "arm,cortex-a73-pmu";
		interrupts = <0x00 0x17 0x04 0x00 0x18 0x04 0x00 0x19 0x04 0x00 0x1a 0x04>;
		interrupt-affinity = <0x07 0x08 0x09 0x0a>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;

		firmware {
		status = "disabled";
			compatible = "berlin,secure-firmware";
		};

		h1@f7000000 {
			compatible = "syna,berlin-h1";
			reg = <0xf7000000 0x400000>;
			interrupts = <0x00 0x1d 0x04>;
			clocks = <0x0b 0x06>;
			status = "disabled";
			phandle = <0x3c>;
		};

		avio@f7400000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "syna,berlin-avio";
			reg = <0xf7400000 0x200000>;
			ranges = <0x00 0xf7400000 0x200000>;
			status = "disabled";
			phandle = <0x3d>;

			dhub {
				compatible = "syna,berlin-dhub";
				frame-rate = <0x3c>;
				interrupts = <0x00 0x21 0x04>;
				interrupt-names = "vpp_dhub";
			};

			aio {
				compatible = "syna,berlin-aio";
				reg = <0xac000 0x400 0x98000 0x8000>;
				reg-names = "aio_base\0gbl_base";
				clocks = <0x0b 0x2b 0x0c 0x00 0x0d 0x00>;
				clock-names = "aio_sysclk\0audio0_clk\0audio1_clk";
			};

			vpp {
				compatible = "syna,berlin-vpp";
				clocks = <0x0e 0x00 0x0f 0x00 0x0b 0x2b 0x0b 0x2a>;
				clock-names = "avio_vclk0\0avio_dpiclk\0aio_sysclk\0avio_txescclk";
				hdtx5v-gpio = <0x10 0x10 0x00>;
				mipirst-gpio = <0x11 0x0c 0x01>;
			};
		};

		vpll0 {
			compatible = "syna,dolphin-pll";
			reg = <0xf749c004 0x20 0xf749c138 0x04>;
			#clock-cells = <0x01>;
			clocks = <0x12>;
			bypass-shift = [00];
			pd-bypass;
			phandle = <0x0e>;
		};

		apll0 {
			compatible = "syna,dolphin-pll";
			reg = <0xf749c028 0x20 0xf749c138 0x04>;
			#clock-cells = <0x01>;
			clocks = <0x12>;
			bypass-shift = [02];
			pd-bypass;
			phandle = <0x0c>;
		};

		apll1 {
			compatible = "syna,dolphin-pll";
			reg = <0xf749c04c 0x20 0xf749c138 0x04>;
			#clock-cells = <0x01>;
			clocks = <0x12>;
			bypass-shift = [03];
			pd-bypass;
			phandle = <0x0d>;
		};

		vpll1 {
			compatible = "syna,dolphin-pll";
			reg = <0xf749c070 0x20 0xf749c138 0x04>;
			#clock-cells = <0x01>;
			clocks = <0x12>;
			bypass-shift = [01];
			pd-bypass;
			phandle = <0x0f>;
		};

		interrupt-controller@f74b8000 {
			compatible = "syna,dolphin-dhub-irq";
			interrupts = <0x00 0x22 0x04>;
			reg = <0xf74b8000 0x418>;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			#address-cells = <0x00>;
			phandle = <0x13>;
		};

		aout@f74ac000 {
			compatible = "syna,berlin-aout";
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x02 0x07 0x0e>;
			interrupt-names = "ma0\0loro\0hdmi\0spdif";
			status = "disabled";
			phandle = <0x3e>;
		};

		i2s-pri {
			compatible = "syna,dolphin-i2s-pri";
			status = "okay";
			interrupt-parent = <0x13>;
			interrupts = <0x00>;
			interrupt-names = "pri";
			pinctrl-0 = <0x14>;
			pinctrl-names = "default";
			output-mclk;
			phandle = <0x16>;
		};

		i2s-sec {
			compatible = "syna,dolphin-i2s-sec";
			status = "disabled";
			interrupt-parent = <0x13>;
			interrupts = <0x02>;
			phandle = <0x3f>;
		};

		spdif-out {
			compatible = "syna,dolphin-spdifo";
			status = "disabled";
			interrupt-parent = <0x13>;
			interrupts = <0x0e>;
			interrupt-names = "spdifo";
			phandle = <0x40>;
		};

		hdmi-out {
			compatible = "syna,dolphin-hdmi";
			status = "okay";
			interrupt-parent = <0x13>;
			interrupts = <0x07>;
			interrupt-names = "hdmi";
			phandle = <0x1b>;
		};

		i2s-mic1 {
			compatible = "syna,dolphin-i2s-mic1";
			status = "okay";
			interrupt-parent = <0x13>;
			interrupts = <0x05>;
			pinctrl-0 = <0x15>;
			pinctrl-names = "default";
			intlmode;
			phandle = <0x19>;
		};

		i2s-mic2 {
			compatible = "syna,dolphin-i2s-mic2";
			status = "disabled";
			interrupt-parent = <0x13>;
			interrupts = <0x06>;
			phandle = <0x41>;
		};

		i2s-mic6 {
			compatible = "syna,dolphin-i2s-mic6";
			status = "disabled";
			interrupt-parent = <0x13>;
			interrupts = <0x0f>;
			phandle = <0x42>;
		};

		i2s_pri_lpbk {
			compatible = "syna,dolphin-i2s-pri-lpbk";
			status = "disabled";
			interrupt-parent = <0x13>;
			interrupts = <0x0a>;
			phandle = <0x43>;
		};

		i2s_hdmi_lpbk {
			compatible = "syna,dolphin-i2s-hdmi-lpbk";
			status = "disabled";
			interrupt-parent = <0x13>;
			interrupts = <0x0b>;
			phandle = <0x44>;
		};

		pdm-pdmi {
			compatible = "syna,dolphin-pdm-pdmi";
			status = "disabled";
			interrupt-parent = <0x13>;
			interrupts = <0x04>;
			phandle = <0x45>;
		};

		dmic-pdm {
			compatible = "syna,dolphin-dmic-pdm";
			status = "disabled";
			interrupt-parent = <0x13>;
			interrupts = <0x04>;
			interleaved-mode;
			interleaved-dummy-data;
			phandle = <0x46>;
		};

		vs680-spdifi {
			compatible = "syna,dolphin-spdifi";
			status = "disabled";
			interrupt-parent = <0x13>;
			sample-rate-32000-margin = <0x1f171717>;
			sample-rate-44100-margin = <0x1f171717>;
			sample-rate-48000-margin = <0x1f171717>;
			sample-rate-88000-margin = <0x1a101010>;
			sample-rate-96000-margin = <0x1a101010>;
			sample-rate-17600-margin = <0xf080808>;
			sample-rate-192000-margin = <0xf070707>;
			interrupts = <0x0f>;
			phandle = <0x47>;
		};

		vs680-pcm {
			compatible = "syna,dolphin-pcm";
			status = "okay";
			phandle = <0x18>;
		};

		vs680-asoc {
			compatible = "syna,dolphin-asoc";
			status = "disabled";
			phandle = <0x48>;

			soc-i2so1 {
				status = "okay";
				stream-name = "soc-i2so1";
				link-name = "soc-i2so1";
				format = "i2s";
				bitclock-inversion;
				frame-inversion;
				bitclock-master;
				frame-master;
				cpu-node = <0x16>;
				codec-node = <0x17>;
				codec-dai-name = "ES8311 HiFi";
				platform-node = <0x18>;
				phandle = <0x49>;
			};

			soc-i2si2 {
				status = "okay";
				stream-name = "soc-i2si2";
				link-name = "soc-i2si2";
				format = "dsp_a";
				bitclock-inversion;
				frame-inversion;
				bitclock-master;
				frame-master;
				cpu-node = <0x19>;
				codec-node = <0x1a>;
				codec-dai-name = "ES7210 4CH ADC";
				platform-node = <0x18>;
				phandle = <0x4a>;
			};

			soc-hdmio {
				status = "okay";
				stream-name = "soc-hdmio";
				link-name = "soc-hdmio";
				format = "i2s";
				cpu-node = <0x1b>;
				codec-name = "snd-soc-dummy";
				codec-dai-name = "snd-soc-dummy-dai";
				platform-node = <0x18>;
				phandle = <0x4b>;
			};
		};

		hrx@f74a0000 {
			compatible = "syna,berlin-hrx";
			interrupt-parent = <0x13>;
			interrupts = <0x09 0x17 0x18 0x19 0x1a 0x1b>;
			interrupt-names = "mic3\0otg\0hdmirx\0ytg\0uvtg\0itg";
			reg = <0xf74a0000 0x8000 0xf7fe2400 0x404>;
			reg-names = "hrx_base\0edid_base";
			status = "disabled";
			pinctrl-0 = <0x1c>;
			pinctrl-names = "default";
			hrxhpd-gpio = <0x1d 0x07 0x00>;
			hrx5v-gpio = <0x10 0x15 0x00>;
			phandle = <0x4c>;
		};

		vxg@f7600000 {
			compatible = "syna,berlin-vxg";
			reg = <0xf7600000 0x200000>;
			interrupts = <0x00 0x01 0x04>;
			clocks = <0x0b 0x05>;
			status = "disabled";
			phandle = <0x4d>;
		};

		ovp@f78c0000 {
			compatible = "syna,berlin-ovp";
			reg = <0xf78c0000 0x10000>;
			clocks = <0x0b 0x07>;
			clock-names = "ovp_coreclk";
			interrupts = <0x00 0x39 0x04>;
			interrupt-names = "ovp_intr";
			status = "disabled";
			phandle = <0x4e>;
		};

		interrupt-controller@f7901000 {
			compatible = "arm,gic-400";
			#interrupt-cells = <0x03>;
			#address-cells = <0x00>;
			interrupt-controller;
			reg = <0xf7901000 0x1000 0xf7902000 0x2000 0xf7904000 0x2000 0xf7906000 0x2000>;
			interrupts = <0x01 0x09 0xf04>;
			phandle = <0x01>;
		};

		hwmon@f7920100 {
			compatible = "syna,dolphin-hwmon";
			reg = <0xf7920100 0x14>;
			interrupts = <0x00 0x48 0x04>;
		};

		cpupll@f7922000 {
			compatible = "syna,dolphin-pll";
			reg = <0xf7922000 0x20 0xf7ea0710 0x04>;
			#clock-cells = <0x01>;
			clocks = <0x12 0x0b 0x00>;
			bypass-shift = [04];
			suspend-resume;
			phandle = <0x05>;
		};

		axi_meter@f7940000 {
			compatible = "syna,dolphin-axi-meter";
			reg = <0xf7940000 0x1000>;
			status = "disabled";
			phandle = <0x4f>;
		};

		gpu@0xf7980000 {
			compatible = "img,powervr";
			reg = <0xf7980000 0x80000>;
			clocks = <0x0b 0x08 0x0b 0x09>;
			clock-names = "gfx3dcore\0gfx3dsys";
			interrupts = <0x00 0x14 0x04>;
			operating-points-v2 = <0x1e>;
			status = "disabled";
			phandle = <0x50>;
		};

		opp_table1 {
			compatible = "operating-points-v2";
			opp-shared;
			phandle = <0x1e>;

			opp@700000000 {
				opp-hz = <0x00 0x29b92700>;
				clock-latency-ns = <0x7a120>;
			};
		};

		tsp@f7a40000 {
			compatible = "syna,berlin-tsp";
			clocks = <0x0b 0x0a 0x0b 0x0b>;
			clock-names = "core\0ref";
			interrupts = <0x00 0x02 0x04>;
			reg = <0xf7a40000 0x40000>;
			status = "disabled";
			phandle = <0x51>;
		};

		shm {
			compatible = "syna,berlin-shm";
			status = "disabled";
			phandle = <0x52>;
		};

		bm {
			compatible = "syna,berlin-bm";
			status = "disabled";
			phandle = <0x53>;
		};

		msg {
			compatible = "syna,berlin-msg";
			status = "disabled";
			phandle = <0x54>;
		};

		drm {
			compatible = "syna,berlin-drm";
			status = "disabled";
			phandle = <0x55>;
		};

		sdhci@f7aa0000 {
			compatible = "snps,dwcmshc-sdhci";
			reg = <0xf7aa0000 0x1000>;
			interrupts = <0x00 0x0d 0x04>;
			clocks = <0x0b 0x0d 0x1f 0x03>;
			clock-names = "core\0bus";
			resets = <0x20 0x680 0x0c 0x00 0x00 0x20 0x688 0x06 0x01 0x00>;
			reset-names = "host\0phy";
			phy-offset = <0x300>;
			bus-width = <0x08>;
			non-removable;
			no-sd;
			no-sdio;
			status = "okay";
			sdclkdl-dc = [1a];
			mmc-ddr-1_8v;
			mmc-hs200-1_8v;
			mmc-hs400-1_8v;
			dll-calibration;
			pad-sp = [0e];
			pad-sn = [0e];
			phandle = <0x56>;
		};

		sdhci@f7ab0000 {
			compatible = "snps,dwcmshc-sdhci";
			reg = <0xf7ab0000 0x1000>;
			interrupts = <0x00 0x0f 0x04>;
			clocks = <0x0b 0x0e 0x1f 0x01>;
			clock-names = "core\0bus";
			resets = <0x20 0x680 0x02 0x00 0x00 0x20 0x688 0x05 0x01 0x00>;
			reset-names = "host\0phy";
			phy-offset = <0x300>;
			bus-width = <0x04>;
			status = "okay";
			pinctrl-0 = <0x21>;
			pinctrl-names = "default";
			no-sdio;
			no-mmc;
			disable-wp;
			sdclkdl-dc = [4b];
			pad-sp = [0c];
			pad-sn = [0c];
			vmmc-supply = <0x22>;
			phandle = <0x57>;
		};

		ethernet@f7b60000 {
			compatible = "snps,dwmac";
			reg = <0xf7b60000 0x2000>;
			interrupts = <0x00 0x2b 0x04>;
			interrupt-names = "macirq";
			clocks = <0x0b 0x0f 0x1f 0x06>;
			clock-names = "stmmaceth\0pclk";
			clk_csr = <0x01>;
			snps,multicast-filter-bins = <0x80>;
			snps,perfect-filter-entries = <0x10>;
			status = "okay";
			pinctrl-0 = <0x23>;
			pinctrl-names = "default";
			phy-handle = <0x24>;
			phy-mode = "rgmii-id";
			snps,reset-gpio = <0x1d 0x01 0x01>;
			snps,reset-delays-us = <0x00 0x2710 0xc350>;
			phandle = <0x58>;

			mdio0 {
				compatible = "snps,dwmac-mdio";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x59>;

				ethernet-phy@0 {
					reg = <0x00>;
					phandle = <0x24>;
				};
			};
		};

		npu@f7bc0000 {
			compatible = "syna,synap\0vivante,galcore";
			reg = <0xf7bc0000 0x40000>;
			resets = <0x20 0x668 0x00 0x01 0x00>;
			interrupts = <0x00 0x69 0x04>;
			clocks = <0x1f 0x05 0x0b 0x15>;
			clock-names = "sys\0core";
			status = "disabled";
			phandle = <0x5a>;
		};

		usb@f7c00000 {
			compatible = "syna,berlin-usb";
			reg = <0xf7c00000 0x40000>;
			interrupts = <0x00 0x0b 0x04>;
			clocks = <0x1f 0x00>;
			clock-names = "otg";
			phys = <0x25>;
			phy-names = "usb2-phy";
			resets = <0x20 0x688 0x03 0x01 0x00 0x20 0x688 0x04 0x01 0x00 0x20 0x680 0x09 0x00 0x00>;
			reset-names = "dwc2\0dwc2-ecc\0dwc2-sync";
			dr_mode = "otg";
			g-rx-fifo-size = <0x200>;
			g-np-tx-fifo-size = <0x40>;
			g-tx-fifo-size = <0x100 0x100 0x100 0x100 0x100 0x80 0x40 0x40 0x40 0x40 0x40 0x40 0x40 0x40 0x40>;
			status = "okay";
			vbus-supply = <0x26>;
			phandle = <0x5b>;
		};

		phy@f7c40000 {
			compatible = "syna,dolphin-usb2-phy";
			reg = <0xf7c40000 0x100>;
			#phy-cells = <0x00>;
			resets = <0x20 0x688 0x02 0x01 0x00>;
			reset-names = "phy";
			status = "okay";
			phandle = <0x25>;
		};

		mc_dfc@f7cb0000 {
			compatible = "syna,dolphin-mc-dfc";
